# =============================================================================
# TEST ENVIRONMENT CONFIGURATION
# Use with: cd docker && docker-compose up -d && docker-compose --profile targets up -d
# =============================================================================

# Application
APP_NAME="Gateway IAM Provisioning - TEST"
APP_VERSION="1.0.0"
DEBUG=true

# =============================================================================
# Database (Gateway IAM)
# =============================================================================
DATABASE_URL="postgresql://gateway:gateway_secret@localhost:5430/gateway_iam"

# =============================================================================
# Message Broker (RabbitMQ)
# =============================================================================
BROKER_TYPE="rabbitmq"
RABBITMQ_HOST="localhost"
RABBITMQ_PORT=5672
RABBITMQ_USER="guest"
RABBITMQ_PASSWORD="guest"
RABBITMQ_VHOST="/"
RABBITMQ_QUEUE="gateway-iam-provisioning"
RABBITMQ_EXCHANGE="gateway-iam"
RABBITMQ_ROUTING_KEY="provisioning"

# =============================================================================
# Approval (in-app auto-approve mode, no SMTP needed)
# =============================================================================
APPROVAL_ENABLED=True
APPROVAL_MODE="auto"
AUTO_APPROVE_DELAY=2

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST="localhost"
REDIS_PORT=6379

# =============================================================================
# Retry Configuration
# =============================================================================
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY=5
RETRY_BACKOFF_MULTIPLIER=2.0
RETRY_MAX_DELAY=300

# =============================================================================
# Target Service: MySQL
# Container: gateway-iam-mysql-target (port 3306)
# =============================================================================
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="mysql_root_secret"
MYSQL_DATABASE="target_db"
MYSQL_CONNECT_TIMEOUT=10

# =============================================================================
# Target Service: PostgreSQL (provisioning target)
# Container: gateway-iam-postgresql-target (port 5433)
# =============================================================================
POSTGRESQL_HOST="localhost"
POSTGRESQL_PORT=5433
POSTGRESQL_USER="target_user"
POSTGRESQL_PASSWORD="target_secret"
POSTGRESQL_DATABASE="target_db"
POSTGRESQL_CONNECT_TIMEOUT=10

# =============================================================================
# Target Service: Odoo
# Container: gateway-iam-odoo (port 8069)
# NOTE: First run requires manual setup at http://localhost:8069
# =============================================================================
ODOO_URL="http://localhost:8069"
ODOO_DB="odoo"
ODOO_USERNAME="admin"
ODOO_PASSWORD="admin"
ODOO_TIMEOUT=30

# =============================================================================
# Logging (verbose for testing)
# =============================================================================
LOG_LEVEL="DEBUG"
LOG_FORMAT="json"

# =============================================================================
# API Configuration
# =============================================================================
API_HOST="0.0.0.0"
API_PORT=8100
API_WORKERS=1
CORS_ORIGINS='["*"]'

