# =============================================================================
# Application Configuration
# =============================================================================
APP_NAME="Gateway IAM Provisioning"
APP_VERSION="1.0.0"
DEBUG=false

# =============================================================================
# Database (Gateway IAM - PostgreSQL)
# =============================================================================
DATABASE_URL="postgresql://gateway:gateway_secret@localhost:5430/gateway_iam"

# =============================================================================
# Message Broker
# =============================================================================
BROKER_TYPE="rabbitmq"

# RabbitMQ Configuration
RABBITMQ_HOST="localhost"
RABBITMQ_PORT=5672
RABBITMQ_USER="guest"
RABBITMQ_PASSWORD="guest"
RABBITMQ_VHOST="/"
RABBITMQ_QUEUE="gateway-iam-provisioning"
RABBITMQ_EXCHANGE="gateway-iam"
RABBITMQ_ROUTING_KEY="provisioning"

# Kafka Configuration (optional, if BROKER_TYPE=kafka)
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_TOPIC="midpoint.provisioning"
KAFKA_CONSUMER_GROUP="gateway-iam"
KAFKA_AUTO_OFFSET_RESET="earliest"
KAFKA_ENABLE_AUTO_COMMIT=true

# =============================================================================
# n8n Integration (Mock for testing)
# =============================================================================
N8N_ENABLED=True
N8N_VALIDATION_WEBHOOK_URL="http://localhost:8101/webhook/validation"
N8N_NOTIFICATION_WEBHOOK_URL="http://localhost:8101/webhook/notification"
N8N_TIMEOUT=30
N8N_RETRY_ATTEMPTS=3

# =============================================================================
# Redis Configuration (for approval workflow)
# =============================================================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# Approval Workflow Configuration
# =============================================================================
APPROVAL_ENABLED=True
APPROVAL_WORKER_URL="http://localhost:5101"
APPROVAL_SLEEP_DURATION=3600  # 1 hour in seconds (use 5 for testing)

# =============================================================================
# Retry Configuration
# =============================================================================
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY=5
RETRY_BACKOFF_MULTIPLIER=2.0
RETRY_MAX_DELAY=300

# =============================================================================
# Target Service: MySQL
# =============================================================================
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="mysql_root_secret"
MYSQL_DATABASE="target_db"
MYSQL_CONNECT_TIMEOUT=10

# =============================================================================
# Target Service: PostgreSQL (separate instance for provisioning)
# =============================================================================
POSTGRESQL_HOST="localhost"
POSTGRESQL_PORT=5433
POSTGRESQL_USER="target_user"
POSTGRESQL_PASSWORD="target_secret"
POSTGRESQL_DATABASE="target_db"
POSTGRESQL_CONNECT_TIMEOUT=10

# =============================================================================
# Target Service: Odoo
# =============================================================================
ODOO_URL="http://localhost:8069"
ODOO_DB="odoo"
ODOO_USERNAME="admin"
ODOO_PASSWORD="admin"
ODOO_TIMEOUT=30

# =============================================================================
# Target Service: LDAP
# =============================================================================
LDAP_HOST="localhost"
LDAP_PORT=10389
LDAP_USE_SSL=false
LDAP_BIND_DN="uid=admin,ou=system"
LDAP_BIND_PASSWORD="secret"
LDAP_BASE_DN="dc=openmicroscopy,dc=org"
LDAP_USER_OBJECT_CLASS="inetOrgPerson"
LDAP_CONNECT_TIMEOUT=10

# =============================================================================
# MidPoint Integration (for connector management dashboard)
# =============================================================================
MIDPOINT_URL="http://localhost:8080/midpoint"
MIDPOINT_USERNAME="administrator"
MIDPOINT_PASSWORD="5ecr3t"
MIDPOINT_TIMEOUT=30

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# =============================================================================
# API Configuration
# =============================================================================
API_HOST="0.0.0.0"
API_PORT=8100
API_WORKERS=1
CORS_ORIGINS='["*"]'
