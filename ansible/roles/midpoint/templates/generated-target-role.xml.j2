<?xml version="1.0" encoding="UTF-8"?>
<role xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      xmlns:icfs="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/resource-schema-3"
      xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3"
      xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3"
      oid="{{ ('gateway-iam:' ~ target_definition.id ~ ':' ~ target_role.key) | to_uuid }}">
    <name>Gateway - {{ target_definition.display_name | e }} - {{ target_role.label | e }}</name>
    <description>Generated by Ansible for target {{ target_definition.id | e }}</description>
    <inducement>
        <construction>
            <resourceRef oid="{{ resource_oid }}" type="c:ResourceType"/>
            <kind>account</kind>
            <intent>default</intent>
            <attribute>
                <ref>ri:roles</ref>
                <outbound>
                    <expression><value>{{ target_definition.id | e }}</value></expression>
                </outbound>
            </attribute>
{% if target_role.association_ref is defined %}
{% set association_value = target_role.association_value | replace(
    '{database}',
    target_definition.deployment.midpoint_database | default('target_db', true)
) %}
{% if target_definition.type == 'ldap' %}
{% set association_value = target_definition.id ~ '.' ~ association_value %}
{% endif %}
            <association>
                <ref>ri:{{ target_role.association_ref }}</ref>
                <outbound>
                    <strength>strong</strength>
                    <expression>
                        <associationTargetSearch>
                            <filter>
                                <q:equal>
                                    <q:path>attributes/icfs:name</q:path>
                                    <q:value>{{ association_value | e }}</q:value>
                                </q:equal>
                            </filter>
                            <searchStrategy>onResourceIfNeeded</searchStrategy>
                        </associationTargetSearch>
                    </expression>
                </outbound>
            </association>
{% endif %}
        </construction>
    </inducement>
</role>
