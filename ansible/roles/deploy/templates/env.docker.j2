# Generated by Ansible — do not edit manually
APP_NAME="Gateway IAM Provisioning"
APP_VERSION="1.0.0"
DEBUG=false
SERVICE_BIND_IP="{{ service_bind_ip }}"
POSTGRESQL_TARGET_HOST_PORT={{ postgresql_target_host_port }}
MONGODB_TARGET_HOST_PORT={{ mongodb_target_host_port }}
LDAP_TARGET_HOST_PORT={{ ldap_target_host_port }}

DATABASE_URL="postgresql://gateway:gateway_secret@postgres:5432/gateway_iam"

BROKER_TYPE="rabbitmq"
RABBITMQ_HOST="rabbitmq"
RABBITMQ_PORT=5672
RABBITMQ_USER="guest"
RABBITMQ_PASSWORD="guest"
RABBITMQ_VHOST="/"
RABBITMQ_QUEUE="gateway-iam-provisioning"
RABBITMQ_EXCHANGE="gateway-iam"
RABBITMQ_ROUTING_KEY="provisioning"

ADMIN_APPROVAL_EMAIL="{{ admin_approval_email | default('admin@example.com') }}"
GATEWAY_EXTERNAL_URL="http://{{ server_ip }}:8100"
GATEWAY_HTTP_URL="http://gateway-http:5100"
ENTITLEMENT_DECISION_TOKEN_DAYS=7
ENTITLEMENT_RECONCILE_TOKEN={{ midpoint_admin_password | string | to_json }}

APPROVAL_ENABLED=True
APPROVAL_MODE="{{ approval_mode | default('email') }}"
AUTO_APPROVE_DELAY=5

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="{{ smtp_user }}"
SMTP_PASSWORD="{{ smtp_password }}"
SMTP_FROM=""
SMTP_STARTTLS=true

RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY=5
RETRY_BACKOFF_MULTIPLIER=2.0
RETRY_MAX_DELAY=300

REDIS_HOST="redis"
REDIS_PORT=6379

MIDPOINT_URL="{{ midpoint_gateway_url }}"
MIDPOINT_USERNAME="{{ midpoint_admin_user }}"
MIDPOINT_PASSWORD="{{ midpoint_admin_password }}"
MIDPOINT_TIMEOUT=30

LOG_LEVEL="INFO"
LOG_FORMAT="json"

API_HOST="0.0.0.0"
API_PORT=8100
API_WORKERS=1
CORS_ORIGINS='["*"]'

# All target connection environments are generated from config/targets.yaml
{% for key, value in gateway_generated_target_environment | default({}) | dictsort %}
{{ key }}={{ value | string | to_json }}
{% endfor %}
