# =============================================================================
# Gateway IAM - Docker Environment Configuration
# All hostnames use Docker container names (not localhost)
# =============================================================================

# Application
APP_NAME="Gateway IAM Provisioning"
APP_VERSION="1.0.0"
DEBUG=false

# Database (internal Docker port 5432, not host-mapped 5430)
DATABASE_URL="postgresql://gateway:gateway_secret@postgres:5432/gateway_iam"

# Message Broker (RabbitMQ)
BROKER_TYPE="rabbitmq"
RABBITMQ_HOST="rabbitmq"
RABBITMQ_PORT=5672
RABBITMQ_USER="guest"
RABBITMQ_PASSWORD="guest"
RABBITMQ_VHOST="/"
RABBITMQ_QUEUE="gateway-iam-provisioning"
RABBITMQ_EXCHANGE="gateway-iam"
RABBITMQ_ROUTING_KEY="provisioning"

# n8n Integration
N8N_ENABLED=True
N8N_VALIDATION_WEBHOOK_URL="http://n8n:5678/webhook/validation"
N8N_NOTIFICATION_WEBHOOK_URL="http://n8n:5678/webhook/notification"
N8N_TIMEOUT=30
N8N_RETRY_ATTEMPTS=3

# n8n Approval Workflow
N8N_APPROVAL_WEBHOOK_URL="http://n8n:5678/webhook/approval"
ADMIN_APPROVAL_EMAIL="samiourrad2005@example.com"
GATEWAY_EXTERNAL_URL="http://gateway-api:8100"

# Approval Workflow
APPROVAL_ENABLED=True
APPROVAL_WORKER_URL="http://approval-worker:5101"
APPROVAL_SLEEP_DURATION=5

# Retry Configuration
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY=5
RETRY_BACKOFF_MULTIPLIER=2.0
RETRY_MAX_DELAY=300

# Redis
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Target Service: MySQL
MYSQL_HOST="mysql-target"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="mysql_root_secret"
MYSQL_DATABASE="target_db"
MYSQL_CONNECT_TIMEOUT=10

# Target Service: PostgreSQL (internal port 5432, not host-mapped 5433)
POSTGRESQL_HOST="postgresql-target"
POSTGRESQL_PORT=5432
POSTGRESQL_USER="target_user"
POSTGRESQL_PASSWORD="target_secret"
POSTGRESQL_DATABASE="target_db"
POSTGRESQL_CONNECT_TIMEOUT=10

# Target Service: Odoo
ODOO_URL="http://odoo:8069"
ODOO_DB="odoo"
ODOO_USERNAME="admin"
ODOO_PASSWORD="admin"
ODOO_TIMEOUT=30

# Target Service: LDAP
LDAP_HOST="ldap"
LDAP_PORT=10389
LDAP_USE_SSL=false
LDAP_BIND_DN="uid=admin,ou=system"
LDAP_BIND_PASSWORD="secret"
LDAP_BASE_DN="dc=openmicroscopy,dc=org"
LDAP_USER_OBJECT_CLASS="inetOrgPerson"
LDAP_CONNECT_TIMEOUT=10

# MidPoint Integration
MIDPOINT_URL="http://midpoint:8080/midpoint"
MIDPOINT_USERNAME="administrator"
MIDPOINT_PASSWORD="5ecr3t"
MIDPOINT_TIMEOUT=30

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# API Configuration
API_HOST="0.0.0.0"
API_PORT=8100
API_WORKERS=1
CORS_ORIGINS='["*"]'
