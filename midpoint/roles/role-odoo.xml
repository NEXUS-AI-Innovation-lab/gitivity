<role oid="00000000-0000-0000-0000-000000000201"
      xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
            xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3">

    <name>odoo3</name>
    <description>Accès Odoo ERP avec création d'employé</description>
    <inducement>
        <construction>
            <resourceRef oid="3447776b-105c-4663-a025-5b27568ee091" type="ResourceType"/>
            <kind>account</kind>
            <attribute>
                <ref>ri:roles</ref>
                <outbound>
                    <expression>
                        <value>odoo</value>
                    </expression>
                </outbound>
            </attribute>
            <attribute>
                <ref>ri:odooCreateUser</ref>
                <outbound>
                    <expression>
                        <value>true</value>
                    </expression>
                </outbound>
            </attribute>
            <attribute>
                <ref>ri:odooCreateEmployee</ref>
                <outbound>
                    <expression>
                        <value>true</value>
                    </expression>
                </outbound>
            </attribute>
        </construction>
    </inducement>
</role>
