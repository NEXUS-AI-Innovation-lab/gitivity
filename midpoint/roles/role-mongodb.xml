<?xml version="1.0" encoding="UTF-8"?>
<role oid="00000000-0000-0000-0000-000000000104"
      xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3">
    <name>mongodb</name>
    <description>Accès MongoDB de base avec le rôle read</description>
    <inducement>
        <construction>
            <resourceRef oid="736ea741-2c73-4478-b5d1-07d84cdf860f" type="ResourceType"/>
            <kind>account</kind>
            <attribute>
                <ref>ri:roles</ref>
                <outbound>
                    <expression><value>mongodb</value></expression>
                </outbound>
            </attribute>
            <attribute>
                <ref>ri:mongodbRoles</ref>
                <outbound>
                    <expression><value>read@target_db</value></expression>
                </outbound>
            </attribute>
        </construction>
    </inducement>
</role>
