<role oid="00000000-0000-0000-0000-000000000102"
      xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
            xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3">
    
    <name>postgresql</name>
    <description>Accès PostgreSQL avec privilèges SELECT, INSERT</description>
    <inducement>
        <construction>
            <resourceRef oid="736ea741-2c73-4478-b5d1-07d84cdf860f" type="ResourceType"/>
            <kind>account</kind>
            <attribute>
                <ref>ri:roles</ref>
                <outbound>
                    <expression>
                        <value>postgresql</value>
                    </expression>
                </outbound>
            </attribute>
            <attribute>
                <ref>ri:postgresqlGrants</ref>
                <outbound>
                    <expression>
                        <value>SELECT, INSERT</value>
                    </expression>
                </outbound>
            </attribute>
        </construction>
    </inducement>
</role>
