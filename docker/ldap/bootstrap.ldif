# =============================================================================
# Bootstrap LDIF - Structure initiale de l'annuaire LDAP
# Chargé automatiquement au premier démarrage du conteneur osixia/openldap
# =============================================================================

# OU : Utilisateurs
dn: ou=Users,dc=openmicroscopy,dc=org
objectClass: top
objectClass: organizationalUnit
ou: Users
description: Unité organisationnelle des utilisateurs

# OU : Groupes
dn: ou=Groups,dc=openmicroscopy,dc=org
objectClass: top
objectClass: organizationalUnit
ou: Groups
description: Unité organisationnelle des groupes

